__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
docs/build/
.coverage
htmlcov/


# Paper figures that notebook 10 writes beside itself when make_notebooks.py
# runs.  The versions that belong to the repository are the ones under
# img/gallery, which that script writes deliberately and which are tracked;
# these are the same plots saved a second time into the working directory,
# and `git add -A` after a regeneration will otherwise pick up all thirteen.
/notebooks/*.pdf

# The paper's build artefacts and the file make_versions.py derives from
# main.tex.  main.tex is the source; these are outputs.  (The figures are
# tracked: they live in figs/, which *.pdf here does not reach.)
resources/paper/*.aux
resources/paper/*.log
resources/paper/*.out
resources/paper/*.spl
resources/paper/*.bbl
resources/paper/*.blg
resources/paper/*.pdf
resources/paper/main_diff.tex
resources/paper/bisect_probe.*

# The benchmark pipeline's own virtual environment, built by
# tests/bench/build.sh from tests/bench/requirements.lock.  The lock file is
# tracked; the tree it installs into is not.
/.venv-bench/
/.bench-build/

# Jupyter's autosave copies.  These are not the notebooks; make_notebooks.py
# generates those, and a checkpoint of one is a stale duplicate.
.ipynb_checkpoints/

# Python bytecode caches under the benchmark tree.
tests/bench/**/__pycache__/

# The accuracy sweep's reference cache.  Derived, rebuildable and large: it
# holds one 50-digit reference per (code, chord, energy) so that a knob sweep
# pays for each reference once rather than once per setting, and so that an
# interrupted sweep resumes.  The artifacts it feeds ARE tracked; this is the
# scratch that produces them.
tests/bench/reference_cache.json
